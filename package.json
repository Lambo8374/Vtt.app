{
  "name": "vtt-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application de circuits VTT : suivi de trace, creation de circuit, metriques km / vitesse / denivele",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
